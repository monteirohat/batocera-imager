{
  "name": "batocera-imager",
  "productName": "Batocera Imager",
  "version": "0.1.0",
  "description": "Unofficial installer for Batocera: pick your device and it writes the right image to a USB key or SD card.",
  "author": "monteirohat",
  "license": "MIT",
  "homepage": "https://github.com/monteirohat/batocera-imager",
  "repository": {
    "type": "git",
    "url": "https://github.com/monteirohat/batocera-imager.git"
  },
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^0.525.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "io.github.monteirohat.batocera-imager",
    "productName": "Batocera Imager",
    "artifactName": "Batocera-Imager-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "monteirohat <monteirohat@users.noreply.github.com>",
      "executableName": "batocera-imager"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "dist/main/**",
      "dist/shared/**"
    ]
  }
}
